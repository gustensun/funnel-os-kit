# Funnel OS environment variables. Add these in Vercel: your project, Settings, Environment Variables.
# Never commit a real .env file. SETUP.md explains each step.

# Required
SUPABASE_URL=                 # Project URL from Supabase, like https://abcdefgh.supabase.co
SUPABASE_PUBLISHABLE_KEY=     # Publishable key from Supabase, starts with sb_publishable_ (the older anon key also works, as SUPABASE_ANON_KEY)
GAI_ENC_KEY=                  # Your secret code: openssl rand -base64 32. Seals every API key saved in the app. Do not change it later.

# Recommended
COACH_NAME=                   # Your full name, like Avery Cole. The coach shows as "Avery AI" and speaks as you. Default: "AI Coach"
COACH_BIO=                    # One line about you. Default: a funnel builder and marketing educator
APP_URL=                      # Your app address, like https://funnels.yourdomain.com. Used in password links and WhatsApp replies

# Advanced, optional
FOS_BUILDER=                  # Model that writes the funnel pages. Default: anthropic/claude-opus-5-5
FOS_IMAGE_MODELS=             # OpenRouter image models to try in order, comma separated. Default: openai/gpt-image-2,google/gemini-3-pro-image,black-forest-labs/flux-3-image

# Test only. The local test server sets these to point at its stand-ins. Leave them unset in Vercel.
# PPLX_BASE_URL, WA_GRAPH_URL, ELEVEN_BASE_URL, WA_CFG_TTL, FOS_VERCEL_API, FOS_GITHUB_API,
# FOS_OPENROUTER_API, FOS_SHOT_API, FOS_GFONTS, FOS_NO_LOOP
